{
  "name": "building-thermal-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Multilayer wall thermal performance calculator (steady-state, ISO 6946-style) for a Civil and Environmental Engineering thesis.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
